   "properties": {
    "id": "T01",
    "nom": "Voyage to France",
    "debut": 1667.6562,
    "fin": 1667.7877,
    "date_edtf": "1667-08-28/1667-10",
    "certitude": "hypothetique",
    "mode": "mer",
    "description": "On August 28, 1667, Louis Jolliet sails from Quebec for France aboard the Saint-Sébastien. He spends the winter there, probably to learn hydrography and trade, before returning to Canada the following year to go into the fur trade.",
    "sources": "Gagnon, Louis Jolliet (2e éd., 1913), p. 41-43.",
    "note": "The port of arrival is not known: La Rochelle, the main port of departure for Canada, is assumed. The route follows the river, the Gulf and the Cabot Strait.",
    "type": "trajet"
   }
