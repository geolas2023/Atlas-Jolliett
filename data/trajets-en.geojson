   "properties": {
    "id": "T04",
    "nom": "From Lachine to Michilimackinac",
    "debut": 1672.7883,
    "fin": 1672.9358,
    "date_edtf": "1672-10/1672-12-08",
    "certitude": "approximative",
    "mode": "terre",
    "description": "Charged by Frontenac with discovering the South Sea by way of the great Mississippi River, Jolliet leaves Lachine in the fall of 1672 with five men. On October 1 he has signed a trading partnership contract with his brother Zacharie and François de Chavigny. He goes up the Ottawa and reaches Georgian Bay: some 350 leagues and about fifty portages. He arrives at the St. Ignace mission at Michilimackinac on December 8.",
    "sources": "Gagnon, Louis Jolliet (2e éd., 1913), p. 63-68, 135; Récit des voyages du P. Marquette (1855), p. 5-6.",
    "note": "",
    "type": "trajet"
   }
